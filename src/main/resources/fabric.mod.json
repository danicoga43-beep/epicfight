{
  "schemaVersion": 1,
  "id": "epicfight",
  "version": "${version}",
  "name": "Epic Fight",
  "description": "Overhauls Minecraft combat with skeletal animation, skills and a stamina system. Fabric port.",
  "authors": [
    "yesman",
    "Epic Fight contributors",
    "Fabric port"
  ],
  "contact": {
    "homepage": "https://epicfight.net"
  },
  "license": "GPL-3.0-only (code); assets: all rights reserved, see LICENSE-ASSETS",
  "icon": "epicfight_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "yesman.epicfight.platform.fabric.EpicFightFabric"
    ],
    "client": [
      "yesman.epicfight.platform.fabric.client.EpicFightFabricClient"
    ],
    "modmenu": [
      "yesman.epicfight.platform.fabric.client.EpicFightModMenu"
    ]
  },
  "mixins": [
    "epicfight.mixins.json",
    "epicfight-platform.fabric.mixins.json"
  ],
  "accessWidener": "epicfight.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "forgeconfigapiport": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}